{"id": "search-pii", "type": "search", "attributes": {"title": "PII masking check (pseudonymized users, redacted e-mails)", "description": "", "columns": ["event.dataset", "user.name", "message", "url.original"], "sort": [["event_time", "desc"]], "grid": {}, "hideChart": true, "kibanaSavedObjectMeta": {"searchSourceJSON": "{\"query\": {\"query\": \"user.name : user-* or message : EMAIL or url.original : *EMAIL*\", \"language\": \"kuery\"}, \"filter\": [], \"indexRefName\": \"kibanaSavedObjectMeta.searchSourceJSON.index\"}"}}, "references": [{"name": "kibanaSavedObjectMeta.searchSourceJSON.index", "type": "index-pattern", "id": "siem-events-dv"}], "coreMigrationVersion": "8.8.0", "typeMigrationVersion": "10.5.0"}
